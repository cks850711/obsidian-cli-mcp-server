{
  "name": "obsidian-cli-mcp-server",
  "version": "0.1.1",
  "description": "Local MCP server that wraps the official Obsidian CLI. Zero third-party network dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "relay": "node dist/relay-server.js",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/parse-args.test.ts"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "cli",
    "llm"
  ],
  "author": "Yuzhen Yang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cks850711/obsidian-cli-mcp-server.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
